# Copy to .env before running docker compose.
# Generate a ready-to-edit .env with strong random secrets:
# python scripts/init_env.py --production --https --output .env

# Deployment mode: local or production.
# P0-12 production authentication: production fails closed unless a valid
# API key, local browser login, or OIDC SSO configuration is present.
# Local mode keeps demo compatibility when no authentication settings are present.
BS_DEPLOYMENT_MODE=local

# Docker Compose host exposure. Loopback-only is the safe default.
# Set BS_BIND_ADDRESS=0.0.0.0 only when an external HTTPS/VPN/reverse-proxy path is intentionally configured.
BS_BIND_ADDRESS=127.0.0.1
BS_HOST_PORT=8000

# Automation/API clients. Use X-API-Key or Authorization: Bearer headers only.
# Query-string API keys are intentionally not supported.
# BS_API_KEY is the optional deployment-wide key and may select organizations.
BS_API_KEY=change-me-long-random-value
# Optional organization-bound delegated API keys as a JSON object.
# Each secret must be unique and must not equal BS_API_KEY.
# Example shape: {"soc-blue":"<24+-random-chars>"}.
BS_ORGANIZATION_API_KEYS={}

# Browser console login. Recommended when humans use the web UI.
BS_ADMIN_PASSWORD=change-me-admin-password
# Optional rule-lifecycle RBAC accounts. Leave unset for legacy single-admin mode.
BS_AUTHOR_PASSWORD=
BS_REVIEWER_PASSWORD=
BS_OPERATOR_PASSWORD=
# Optional partial per-organization RBAC permission overrides as JSON.
# Omitted organizations/roles keep the built-in role permissions; [] removes all
# role-gated permissions for that role. Known permissions:
# rule.author, rule.review, rule.operate, analysis.custom_rules, case.object_storage
# Example:
# {"soc-blue":{"operator":["analysis.custom_rules"],"author":[]}}
BS_ORGANIZATION_RBAC_POLICIES={}

# Optional SCIM 2.0 user provisioning. Use a dedicated random bearer token that
# is not reused as an API key, password, OIDC client secret, or session secret.
# When SCIM and OIDC are both enabled, OIDC sub must match an active SCIM
# externalId and SCIM becomes the source of truth for role + organization.
BS_SCIM_BEARER_TOKEN=
BS_SCIM_USER_STORE_PATH=~/.breachscope/scim_users.json

# Optional OIDC SSO. Leave all BS_OIDC_* values empty to disable SSO.
# Role claim values are exact comma-separated matches. Multiple matching non-admin roles are rejected.
BS_OIDC_ISSUER_URL=
BS_OIDC_CLIENT_ID=
BS_OIDC_CLIENT_SECRET=
BS_OIDC_REDIRECT_URI=
BS_OIDC_SCOPES=openid profile email
BS_OIDC_ROLE_CLAIM=groups
# Optional dotted claim path. When set, it must resolve to exactly one safe organization ID.
BS_OIDC_ORGANIZATION_CLAIM=
BS_OIDC_DEFAULT_ROLE=
BS_OIDC_ADMIN_VALUES=
BS_OIDC_AUTHOR_VALUES=
BS_OIDC_REVIEWER_VALUES=
BS_OIDC_OPERATOR_VALUES=
# Auto: client_secret_basic when a secret exists, otherwise none.
BS_OIDC_TOKEN_AUTH_METHOD=

# Optional SCIM 2.0 Users provisioning. When enabled with OIDC, SCIM externalId
# must equal OIDC sub and SCIM becomes the role/organization authority.
# Use a dedicated 24+ character random bearer token that is not reused elsewhere.
BS_SCIM_BEARER_TOKEN=
BS_SCIM_USER_STORE_PATH=/data/scim_users.json

BS_SESSION_SECRET=change-me-long-random-session-secret
BS_SESSION_TTL_SECONDS=28800
# Set to 1 when served behind HTTPS and you want Secure cookies forced.
BS_COOKIE_SECURE=0

BS_DISABLE_DOCS=0
BS_CASES_ROOT=/data/cases
# P0-11 work_dir boundary: user-selected work_dir values must be strict descendants
# of BS_CASES_ROOT. Relative work_dir values resolve below this root.
BS_CASE_HISTORY_PATH=/data/case_history.json
# Default organization for local/password sessions and legacy case rows.
BS_DEFAULT_ORGANIZATION_ID=default

# Audit trail. JSONL is append-only; set BS_AUDIT_ENABLED=0 only for disposable demos.
BS_AUDIT_ENABLED=1
BS_AUDIT_LOG_PATH=/data/audit.jsonl
BS_RULE_TUNING_PATH=/data/rule_tuning_profiles.json
BS_RULE_AUTHORING_ROOT=/data/rule_authoring
BS_RULE_ACTIVATION_PATH=/data/rule_activation.json
# Optional AES-256-GCM at-rest encryption for retained case inputs/reports. Must decode to 32 bytes.
BS_ARTIFACT_ENCRYPTION_KEY=
# Optional S3-compatible remote replication for encrypted retained cases.
# Credentials are resolved by the standard AWS SDK credential chain.
BS_OBJECT_STORAGE_PROVIDER=
BS_OBJECT_STORAGE_BUCKET=
BS_OBJECT_STORAGE_PREFIX=breachscope/cases
BS_OBJECT_STORAGE_REGION=
BS_OBJECT_STORAGE_ENDPOINT_URL=
# Optional HMAC over audit log exports/integrity checks.
BS_AUDIT_CHAIN_SECRET=change-me-audit-chain-secret

# Optional: keep uploaded web workdirs after analysis. Default is keep.
BS_WEB_CLEANUP_AFTER_ANALYSIS=0

# P1-01 bounded streaming uploads.
BS_UPLOAD_CHUNK_BYTES=1048576
BS_UPLOAD_MAX_FILE_BYTES=536870912
BS_UPLOAD_MAX_TOTAL_BYTES=1073741824
BS_UPLOAD_MAX_FILES=32
BS_UPLOAD_MAX_REQUEST_BYTES=1107296256

# Optional Korean PDF font override.
# BS_PDF_FONT_REGULAR=/usr/share/fonts/truetype/nanum/NanumGothic.ttf
# BS_PDF_FONT_BOLD=/usr/share/fonts/truetype/nanum/NanumGothicBold.ttf

# Login brute-force protection.
BS_AUTH_MAX_FAILURES=5
BS_AUTH_LOCKOUT_SECONDS=300
BS_AUTH_RATE_LIMIT_PATH=/data/auth_rate_limit.json
# Comma-separated exact IP addresses of reverse proxies allowed to supply
# X-Forwarded-For for login rate-limit identity. Leave blank to ignore XFF.
BS_TRUSTED_PROXY_IPS=

# Local ZIP backups for case history, case files, and audit log.
BS_BACKUP_ROOT=/data/backups

# Operational probes and diagnostics.
# /api/health/live and /api/health/ready are always available for container probes.
# /api/metrics, /api/metrics.json, /api/ops/config-check, /api/ops/self-test are protected when auth is enabled.
# No additional environment variables are required.

# Optional build metadata exposed by /api/ops/release-info.
BS_BUILD_VERSION=local
BS_BUILD_SHA=local
BS_BUILD_TAG=
BS_BUILD_TIME=local

# Optional Hayabusa detection backend (P0-10)
# Runtime binary may also be auto-resolved from the BreachScope user tools directory.
BS_HAYABUSA_ENABLED=0
BS_HAYABUSA_EXE=
BS_HAYABUSA_TIMEOUT=600
# Comma-separated exact browser origins allowed for credentialed CORS.
# Leave blank unless a separate frontend origin is required. Same-origin access is unaffected.
BS_ALLOWED_ORIGINS=
