# Copy to .env before running docker compose.
# Generate a ready-to-edit .env with strong random secrets:
# python scripts/init_env.py --production --https --output .env

# Deployment mode: local or production. Production is stricter in go-live checks.
BS_DEPLOYMENT_MODE=local

# Automation/API clients. Leave blank for local demos, set for shared deployments.
BS_API_KEY=change-me-long-random-value

# Browser console login. Recommended when humans use the web UI.
BS_ADMIN_PASSWORD=change-me-admin-password
BS_SESSION_SECRET=change-me-long-random-session-secret
BS_SESSION_TTL_SECONDS=28800
# Set to 1 when served behind HTTPS and you want Secure cookies forced.
BS_COOKIE_SECURE=0

BS_DISABLE_DOCS=0
BS_CASES_ROOT=/data/cases
# P0-11 work_dir boundary: user-selected work_dir values must be strict descendants
# of BS_CASES_ROOT. Relative work_dir values resolve below this root.
BS_CASE_HISTORY_PATH=/data/case_history.json

# Audit trail. JSONL is append-only; set BS_AUDIT_ENABLED=0 only for disposable demos.
BS_AUDIT_ENABLED=1
BS_AUDIT_LOG_PATH=/data/audit.jsonl
# Optional HMAC over audit log exports/integrity checks.
BS_AUDIT_CHAIN_SECRET=change-me-audit-chain-secret

# Optional: keep uploaded web workdirs after analysis. Default is keep.
BS_WEB_CLEANUP_AFTER_ANALYSIS=0

# Optional Korean PDF font override.
# BS_PDF_FONT_REGULAR=/usr/share/fonts/truetype/nanum/NanumGothic.ttf
# BS_PDF_FONT_BOLD=/usr/share/fonts/truetype/nanum/NanumGothicBold.ttf

# Login brute-force protection.
BS_AUTH_MAX_FAILURES=5
BS_AUTH_LOCKOUT_SECONDS=300
BS_AUTH_RATE_LIMIT_PATH=/data/auth_rate_limit.json

# Local ZIP backups for case history, case files, and audit log.
BS_BACKUP_ROOT=/data/backups

# Operational probes and diagnostics.
# /api/health/live and /api/health/ready are always available for container probes.
# /api/metrics, /api/metrics.json, /api/ops/config-check, /api/ops/self-test are protected when auth is enabled.
# No additional environment variables are required.

# Optional build metadata exposed by /api/ops/release-info.
BS_BUILD_VERSION=local
BS_BUILD_SHA=local
BS_BUILD_TAG=
BS_BUILD_TIME=local

# Optional Hayabusa detection backend (P0-10)
# Runtime binary may also be auto-resolved from the BreachScope user tools directory.
BS_HAYABUSA_ENABLED=0
BS_HAYABUSA_EXE=
BS_HAYABUSA_TIMEOUT=600
